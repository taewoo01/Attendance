# Supabase Dashboard > Project Settings > API에서 확인.
# 이 파일을 .env.local로 복사한 뒤 실제 값을 채운다. .env.local은 Git에 커밋하지 않는다.

# 브라우저에 노출되는 공개 값(anon key는 RLS 전제이므로 공개되어도 안전하다).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 절대 NEXT_PUBLIC_* 로 만들지 않는다. 클라이언트 번들에 포함되면 안 된다.
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle(drizzle-kit generate/migrate 및 src/lib/db/client.ts)이 사용하는 Postgres 직접 연결 문자열.
# Supabase Dashboard > Project Settings > Database > Connection string(Transaction pooler 권장)에서 확인.
# 서버 전용. 절대 NEXT_PUBLIC_* 로 만들지 않는다.
DATABASE_URL=
